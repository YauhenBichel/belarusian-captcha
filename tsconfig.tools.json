{
  "//": "Type-checks the tests and root config files (not emitted to any package's dist). allowImportingTsExtensions: scripts that Node runs directly (type stripping) import each other with the .ts extension.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "node_modules/.cache/tsc-tools",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "resolveJsonModule": true
  },
  "include": [
    "vitest.config.ts",
    "shared/src/**/*.ts",
    "server/src/**/*.ts",
    "server/test/**/*.ts",
    "scripts/**/*.ts",
    "widget/src/**/*.ts",
    "widget/src/i18n/*.json",
    "sdk/node/src/**/*.ts",
    "sdk/node/test/**/*.ts",
    "demo/backends/*/src/**/*.ts",
    "demo/backends/*/test/**/*.ts",
    "e2e/**/*.ts"
  ]
}
