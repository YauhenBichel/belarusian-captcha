{
  "name": "belarusian-captcha-workspace",
  "private": true,
  "description": "Workspace root for belarusian-captcha (not published).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b --builders 1",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:widget && npm run check:package",
    "build": "tsc -b --builders 1 && npm run build:widget && npm run build -w sdk/node",
    "build:widget": "npm run build -w widget",
    "build:demo": "npm run build:widget && node demo/build.mjs",
    "check:package": "npm run build -w sdk/node && node scripts/check-package.mjs",
    "e2e": "playwright test -c e2e",
    "//": "tsc 7 builds referenced projects in parallel; one builder keeps shared/ ahead of server/ and the tools project on a clean checkout."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "altcha-lib": "2.9.0",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "workspaces": [
    "shared",
    "server",
    "widget",
    "sdk/node"
  ]
}
