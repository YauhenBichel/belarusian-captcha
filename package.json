{
  "name": "belarusian-captcha-workspace",
  "private": true,
  "description": "Workspace root for belarusian-captcha (not published).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm test",
    "build": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "altcha-lib": "2.9.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "workspaces": [
    "shared",
    "server"
  ]
}
